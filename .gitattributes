# Normalise text files to LF in the repository; check out with native endings where needed.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# The bundled sample's manifest records exact file sizes — keep its bytes unchanged.
samples/** -text

# Binary assets — never modify bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.pdf binary
*.stl binary
*.dwg binary
*.step binary
*.stp binary
*.woff binary
*.woff2 binary
